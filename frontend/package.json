{
  "name": "handwriting-notes-digitizer-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web frontend for the Handwriting Notes Digitizer (upload UI, Editor, Calibration UI, Before/After view).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "katex": "0.16.22"
  },
  "devDependencies": {
    "@types/katex": "0.16.7",
    "@types/node": "20.19.6",
    "@vitest/coverage-v8": "2.1.5",
    "fast-check": "3.23.1",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}

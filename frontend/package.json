{
  "name": "handwriting-notes-digitizer-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web client for Handwriting Notes Digitizer: import, source-linked prose/formula review, sync, and export.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-slot": "1.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "katex": "0.18.2",
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.1.14",
    "@types/katex": "0.16.7",
    "@types/node": "20.19.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "2.1.5",
    "fast-check": "3.23.1",
    "jsdom": "25.0.1",
    "tailwindcss": "4.1.14",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}

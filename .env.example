# .env.example — Handwriting Notes Digitizer
#
# Copy this file to .env and adjust values before running `docker compose up`.
# All variables have documented defaults; only override what you need.
#
# Partial deployment (Req 11.5):
#   Set a component variable to "false" to disable it.  The system will
#   continue serving capabilities whose required components remain enabled.
#   See capability_registry.py for the full capability → component mapping.
#
#   Component         | Env var                       | Affects capabilities
#   ──────────────────|───────────────────────────────|──────────────────────────────────
#   storage           | HND_STORAGE_AVAILABLE         | image_upload, recognition,
#                     |                               | correction, export, calibration
#   htr_engine        | HND_HTR_ENGINE_AVAILABLE      | recognition, calibration
#   training_worker   | HND_TRAINING_WORKER_AVAILABLE | personalization
#
# Examples:
#   Run without personalization:  HND_TRAINING_WORKER_AVAILABLE=false
#   Run recognition only:         HND_TRAINING_WORKER_AVAILABLE=false
#   Run frontend only (no ML):    HND_HTR_ENGINE_AVAILABLE=false HND_TRAINING_WORKER_AVAILABLE=false

# ── Partial-deployment component toggles ─────────────────────────────────────
# All default to "true" (fully enabled). Set to "false", "0", or "no" to disable.
HND_ENVIRONMENT=production
HND_STORAGE_AVAILABLE=true
HND_HTR_ENGINE_AVAILABLE=true
HND_TRAINING_WORKER_AVAILABLE=true

# ── Persistence ───────────────────────────────────────────────────────────────
# SQLAlchemy database URL. Default: SQLite file inside the container.
# For PostgreSQL: postgresql+psycopg2://user:password@host:5432/hnd
HND_DATABASE_URL=sqlite:///./var/hnd.db

# Filesystem root for uploaded images, region crops, and adapter weights.
HND_OBJECT_STORE_PATH=/app/var/objectstore

# ── Reproducibility ───────────────────────────────────────────────────────────
# Master random seed applied to Python / NumPy / PyTorch RNGs (Req 11.3).
HND_RANDOM_SEED=1337

# Enable deterministic execution (True/False). Must be True for reproducibility.
HND_DETERMINISTIC=true

# ── Base model training (local only — not used at container runtime) ─────────
# Points the IAM data pipeline (app/ml/iam_dataset.py) at a real, licensed IAM
# Handwriting Database download so app/ml/run_real_training.py trains on real
# handwriting instead of the deterministic-noise placeholder used when this is
# unset. Must point at the directory containing the IAM `lines/<form>/...png`
# layout (e.g. backend/datasets/lines). See backend/app/ml/BASE_MODEL_TRAINING.md.
# HND_IAM_DATASET_ROOT=./backend/datasets/lines

# ── Recognition limits ────────────────────────────────────────────────────────
# Maximum accepted image upload size in bytes (default 10 MB = 10485760).
HND_MAX_UPLOAD_BYTES=10485760

# Recognition time budget in seconds; requests exceeding this are cancelled (Req 2.6).
HND_RECOGNITION_TIMEOUT_SECONDS=10.0
HND_PDF_RASTER_DPI=200
HND_PDF_MAX_PAGES=50
HND_PDF_MAX_PIXELS=40000000

# Formula backend: auto (UniMERNet, then compact fallback), unimernet, or compact.
HND_FORMULA_ENGINE=auto

# ── Personalization ───────────────────────────────────────────────────────────
# Number of unused Training_Pairs that triggers adapter training (Req 5.1).
HND_PERSONALIZATION_TRIGGER_THRESHOLD=20
HND_HELD_OUT_FRACTION=0.2
HND_HELD_OUT_MIN_PAIRS=5
HND_MAX_TRAINING_EPOCHS=50
# Keep false unless an explicitly synthetic evaluation is being run locally.
HND_ALLOW_SYNTHETIC_EVAL=false

# ── Frontend ──────────────────────────────────────────────────────────────────
# Host port to expose the nginx frontend on (default 80).
FRONTEND_PORT=80

# Backend base URL used by the frontend at build time. Leave empty to use
# relative /api/* paths (nginx proxies these to the backend container).
# Set to an absolute URL when the frontend and backend are on different origins.
VITE_API_BASE_URL=

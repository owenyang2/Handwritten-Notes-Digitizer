# Copy to an ignored .env.production file and fill every required secret.
# Generate independent values with: openssl rand -hex 32
HND_POSTGRES_PASSWORD=
HND_S3_ADMIN_ACCESS_KEY=
HND_S3_ADMIN_SECRET_KEY=
HND_S3_ACCESS_KEY=
HND_S3_SECRET_KEY=
# Retain this key with backups; changing it makes existing encrypted data unreadable.
HND_S3_ENCRYPTION_KEY=
HND_S3_BUCKET=hnd-objects
FRONTEND_PORT=8080

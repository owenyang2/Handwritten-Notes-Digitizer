# Dockerfile.frontend — Handwriting Notes Digitizer frontend service
#
# Multi-stage build:
#   Stage 1 (builder) — installs pinned Node dependencies and runs
#                        `npm run build` to produce the static bundle in /dist
#   Stage 2 (runtime) — copies only the built assets into a minimal nginx image
#
# No manual code modification is required during the build (Req 11.1).
# The frontend is served at port 80 by nginx.

# ── Stage 1: build ──────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency manifests first to maximise layer caching.
COPY frontend/package.json frontend/package-lock.json ./

# Install exact versions from package-lock.json (ci never upgrades packages).
RUN npm ci --ignore-scripts

# Copy the full frontend source.
COPY frontend/ .

# Build the production bundle.
# VITE_API_BASE_URL is intentionally left empty so the frontend uses relative
# paths; nginx proxies /api-prefixed (or same-origin) requests to the backend.
# Override this ARG at build time if you need a different backend origin:
#   docker build --build-arg VITE_API_BASE_URL=https://api.example.com …
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# Remove the default nginx HTML so only the built app is served.
RUN rm -rf /usr/share/nginx/html/*

# Copy built assets from the builder stage.
COPY --from=builder /app/dist /usr/share/nginx/html

# nginx configuration is provided via docker-compose volume mount or bundled
# here as a fallback.  The bundled config is overridden by compose.
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose HTTP port (Req 11.1, 11.4)
EXPOSE 80

# Health check — nginx serves the app at /
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ > /dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
